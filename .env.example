DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SSL_MODE=require
JWT_SECRET_KEY=change-this-secret-to-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ALLOW_ORIGINS=http://localhost:4200,https://santi-osp.github.io/superMarketFrontEnd/login
CORS_ALLOW_CREDENTIALS=true
RUN_SEEDERS_ON_STARTUP=false
HTTP_CLIENT_BASE_URL=http://localhost:8000
